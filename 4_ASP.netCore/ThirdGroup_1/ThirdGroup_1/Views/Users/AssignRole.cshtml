@model User
@{
    ViewData["Title"] = "Assign Roles";

    List<Role> allroles = ViewBag.Roleslist;

    List<int> assignedids = ViewBag.AssignedRolesList;
}

<h1>@ViewData["Title"]</h1>
<h2>@Model.Name Roles : </h2>
<hr />

<form asp-action="AssignRole" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    @foreach (var role in allroles!)
    {
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   name="roleIds"
                   value="@role.Id"
                   checked="@(assignedids!.Contains(role.Id))" />
            <label class="form-check-label">
                @role.Name
            </label>

        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</form>

