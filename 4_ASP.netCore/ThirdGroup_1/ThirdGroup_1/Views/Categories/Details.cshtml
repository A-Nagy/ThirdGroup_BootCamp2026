@model Category
@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">بيانات الصنف</h4>
                </div>
                <div class="card-body">
                    <form asp-action="/" method="post">

                        <input type="hidden" asp-for="Id" />
                    
                        <div class="mb-3">
                            <label class="form-label">اسم الصنف <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="أدخل اسم الصنف" disabled />
                        </div>

                    
                        <div class="mb-3">
                            <label class="form-label">وصف الصنف </label>
                            <textarea asp-for="Description" type="text" class="form-control"  disabled ></textarea>
                        </div>
 
                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index"  class="btn btn-primary">الرجوع القائمة </a>
                            <a asp-action="Update" class="btn btn-warning" asp-route-Id="@Model.Id">تحديث بيانات الصنف</a>
                            <a asp-action="Delete" class="btn btn-danger" asp-route-Id="@Model.Id">حذف الصنف</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


