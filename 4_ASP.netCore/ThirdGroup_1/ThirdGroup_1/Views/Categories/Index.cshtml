@model List<Category>
@{
    ViewData["Title"] = "Category Page";
}


<h1>Category Information</h1>

<table class="table table-borderd">
    <tr>
        <th>#</th>
        <th>Category Name</th>
        <th>Category Description</th>
        
    </tr>

    @foreach (var cat in Model)
    {
        <tr>
            <td>@cat.Id</td>
            <td>@cat.Name</td>
            <td>@cat.Description</td>
          
            <td>
                <a class="btn btn-secondary" asp-controller="Categories" asp-action="Details" asp-route-id="@cat.Id">Details</a>
                <a class="btn btn-warning" asp-controller="Categories" asp-action="update" asp-route-id="@cat.Id">Update</a>
                <a class="btn btn-danger" asp-controller="Categories" asp-action="delete" asp-route-id="@cat.Id">Delete</a>
            </td>
        </tr>
    }
</table>
<a class="btn btn-success" asp-controller="Categories" asp-action="insert">Add Category</a>
<a class="btn btn-primary" asp-controller="Categories" asp-action="Search">Search</a>