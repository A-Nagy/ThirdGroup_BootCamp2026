

@{
    ViewData["Title"] = "My Access";
    var roles = User.Claims.Where(c => c.Type == ClaimTypes.Role)
                           .Select(c => c.Value)
                           .Distinct()
                           .ToList();
    var permissions = User.Claims.Where(c => c.Type == "Permission")
                                 .Select(c => c.Value)
                                 .Distinct()
                                 .ToList();   

}

<h1>My Access</h1>
<hr />
<h4>User : </h4>
<p>
@User.Identity?.Name
</p>
<hr />
<h4>Roles : </h4>
@if (roles.Any())
{
    <ul>
        @foreach (var role in roles)
        {
            <li>@role</li>
        }
    </ul>
}else
{
    <p> No Roles Assigned</p>
}

<hr />

<h4>Permissions : </h4>
@if (permissions.Any())
{
    <ul>
        @foreach (var permission in permissions)
        {
            <li>@permission</li>
        }
    </ul>
}
else
{
    <p> No permission Assigned</p>
}