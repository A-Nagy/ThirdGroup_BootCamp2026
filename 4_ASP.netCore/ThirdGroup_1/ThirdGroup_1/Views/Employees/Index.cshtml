@model List<Employee>
@{
    ViewData["Title"] = "Employee Page";
}


  <h1>Employees Information</h1>

 <table class="table table-borderd">
    <tr>
        <th>#</th>
        <th>Employee Name</th>
        <th>Employee Email</th>
        <th>Employee Phone</th>
        <th>Employee Age</th>
        <th>Employee Salary</th>
    </tr>
    
    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.EmployeeId</td>
            <td>@emp.EmployeeName</td>
            <td>@emp.EmployeeEmail</td>
            <td>@emp.EmployeePhone</td>
            <td>@emp.EmployeeAge</td>
            <td>@emp.EmployeeSalary</td>
            <td>@emp.Department?.Name</td>
            <td>
                <a class="btn btn-secondary" asp-controller="Employees" asp-action="Details" asp-route-id="@emp.EmployeeId">Details</a>
                <a class="btn btn-warning" asp-controller="Employees" asp-action="update" asp-route-id="@emp.EmployeeId">Update</a>
                <a class="btn btn-danger" asp-controller="Employees" asp-action="delete" asp-route-id="@emp.EmployeeId">Delete</a>
            </td>
        </tr>
    }
</table>
<a class="btn btn-success" asp-controller="Employees" asp-action="insert">Add Employee</a>
<a class="btn btn-primary" asp-controller="Employees" asp-action="Search">Search</a>